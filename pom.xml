<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.mcaccess</groupId>
    <artifactId>prism</artifactId>
    <version>0.16.3</version>

    <name>PRISM</name>
    <description>Java bindings for PRISM.</description>
    <url>https://github.com/minecraft-access/prism</url>
    <inceptionYear>2026</inceptionYear>
    <licenses>
        <license>
            <name>MPL-2.0</name>
            <url>https://www.mozilla.org/en-US/MPL/2.0/</url>
        </license>
    </licenses>
    <organization>
        <name>Minecraft Access</name>
        <url>https://github.com/minecraft-access</url>
    </organization>
    <developers>
        <developer>
            <id>sgmedev</id>
            <name>Joel Hooimeyer</name>
            <email>me@sgme.dev</email>
            <url>https://github.com/sgmedev</url>
            <timezone>Australia/Sydney</timezone>
            <roles>
                <role>Maintainer</role>
            </roles>
        </developer>
    </developers>
    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/minecraft-access/prism/issues</url>
    </issueManagement>
    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/minecraft-access/prism/actions</url>
    </ciManagement>
    <scm>
        <connection>scm:git:https://github.com/minecraft-access/prism</connection>
        <developerConnection>scm:git:git@github.com:minecraft-access/prism</developerConnection>
        <url>https://github.com/minecraft-access/prism</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.build.outputTimestamp>${maven.build.timestamp}</project.build.outputTimestamp>
        <maven.compiler.release>21</maven.compiler.release>
        <prism>${project.build.directory}/prism-sdk-v${project.version}</prism>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.8</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.9.0</version>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <groupId>io.github.download-maven-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <version>2.1.0</version>
                <executions>
                    <execution>
                        <phase>initialize</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>https://github.com/ethindp/prism/releases/download/v${project.version}/prism-sdk-v${project.version}.zip</url>
                            <unpack>true</unpack>
                            <sha256>d4ae9efbc7e99749b904282862d34e4e55c3668cdff03948b48d280d86e2fde0</sha256>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/natives</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${prism}/linux/x64/dynamic/release/lib</directory>
                                    <targetPath>linux/amd64</targetPath>
                                    <includes>
                                        <include>libprism.so</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${prism}/linux/arm64/dynamic/release/lib</directory>
                                    <targetPath>linux/aarch64</targetPath>
                                    <includes>
                                        <include>libprism.so</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${prism}/windows/x64/dynamic/release/bin</directory>
                                    <targetPath>windows/amd64</targetPath>
                                    <includes>
                                        <include>prism.dll</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${prism}/windows/arm64/dynamic/release/bin</directory>
                                    <targetPath>windows/aarch64</targetPath>
                                    <includes>
                                        <include>prism.dll</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${prism}/macos/universal/dynamic/release/lib</directory>
                                    <targetPath>mac</targetPath>
                                    <includes>
                                        <include>libprism.dylib</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.1</version>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>jextract</executable>
                            <arguments>
                                <argument>--output</argument>
                                <argument>${project.build.directory}/generated-sources/jextract</argument>
                                <argument>--target-package</argument>
                                <argument>org.mcaccess.prism.natives</argument>
                                <argument>${prism}/include/prism.h</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
